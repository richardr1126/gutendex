# Copy to charts/.env (gitignored) and run ./create_secrets.sh.

# Django's signing key. openssl rand -hex 32
SECRET_KEY=

# The gutendex database user's password. openssl rand -hex 24
# Read by Postgres only when its volume is first initialised.
DATABASE_PASSWORD=

# Keys clients must send as X-API-Key or Authorization: Bearer.
# Comma-separate several to rotate without breaking older clients.
# openssl rand -hex 32
API_KEYS=
